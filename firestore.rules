rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A chave da viagem é o hash do código da família (64 caracteres).
    // Ninguém pode listar /viagens, então sem o código não se chega aos dados.
    function chaveValida(k) {
      return k is string && k.size() == 64;
    }

    function configValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['cotacao', 'marcos', 'criadoEm', 'atualizadoEm'])
        && (!d.keys().hasAny(['cotacao']) || (d.cotacao is number && d.cotacao >= 1 && d.cotacao <= 50))
        && (!d.keys().hasAny(['marcos']) || d.marcos is map);
    }

    function progressoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pct', 'pts', 'medalhas', 'meses', 'docs', 'pinTag', 'atualizadoEm'])
        && (!d.keys().hasAny(['pct']) || (d.pct is number && d.pct >= 0 && d.pct <= 100))
        && (!d.keys().hasAny(['pts']) || d.pts is number)
        && (!d.keys().hasAny(['medalhas']) || d.medalhas is map)
        && (!d.keys().hasAny(['meses']) || d.meses is list)
        && (!d.keys().hasAny(['docs']) || d.docs is map)
        && (!d.keys().hasAny(['pinTag']) || d.pinTag is string);
    }

    function privadoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['brl', 'usd', 'milhas', 'programas', 'vencimentos', 'fator', 'plano', 'metaCustom', 'historico', 'atualizadoEm'])
        && (!d.keys().hasAny(['historico']) || d.historico is map)
        && (!d.keys().hasAny(['programas']) || d.programas is map)
        && (!d.keys().hasAny(['vencimentos']) || d.vencimentos is map)
        && (!d.keys().hasAny(['fator']) || (d.fator is number && d.fator > 0 && d.fator <= 10))
        && d.brl is number && d.brl >= 0
        && d.usd is number && d.usd >= 0
        && d.milhas is number && d.milhas >= 0
        && d.plano is string
        && d.metaCustom is number && d.metaCustom >= 0;
    }

    // Cotação e linha do tempo compartilhadas.
    match /viagens/{viagem}/config/{doc} {
      allow get: if chaveValida(viagem) && doc == 'geral';
      allow create, update: if chaveValida(viagem) && doc == 'geral' && configValida();
      allow list, delete: if false;
    }

    // Percentual, pontos, medalhas e documentos: nunca guarda valores.
    match /viagens/{viagem}/progresso/{nucleo} {
      allow read: if chaveValida(viagem);
      allow create, update: if chaveValida(viagem)
        && nucleo in ['tarcisio', 'beth', 'paulo', 'geraldo']
        && progressoValido();
      allow delete: if false;
    }

    // Valores de cada núcleo. O caminho depende do PIN e não pode ser listado.
    match /viagens/{viagem}/privado/{chavePrivada} {
      allow get: if chaveValida(viagem) && chaveValida(chavePrivada);
      allow create, update: if chaveValida(viagem) && chaveValida(chavePrivada) && privadoValido();
      allow list, delete: if false;
    }
  }
}
